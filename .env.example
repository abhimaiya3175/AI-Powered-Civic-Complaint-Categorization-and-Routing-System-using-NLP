# Backend configuration template
# Copy to .env and set secure values for local/dev environments.

# JWT
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Database (used when DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bbmp_complaints

# Optional override (uncomment to use a full connection string)
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/bbmp_complaints

# Optional admin bootstrap credentials (docker-compose)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
